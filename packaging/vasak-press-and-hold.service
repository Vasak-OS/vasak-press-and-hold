[Unit]
Description=VasakOS press-and-hold accent picker
Documentation=https://github.com/Vasak-OS/vasak-press-and-hold
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/vasak-press-and-hold
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
