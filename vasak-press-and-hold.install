post_install() {
    # The daemon belongs to the graphical session. Nothing enabled it before,
    # so the feature was installed and never ran.
    mkdir -p /etc/systemd/user/graphical-session.target.wants
    ln -sf /usr/lib/systemd/user/vasak-press-and-hold.service \
        /etc/systemd/user/graphical-session.target.wants/vasak-press-and-hold.service

    # Loading uinput now rather than at the next boot: the rules can only grant
    # access to a device that exists, and until the module is loaded /dev/uinput
    # is a static node with nothing behind it.
    modprobe uinput 2>/dev/null || true

    # The rule used to be numbered 99, which is after the point where systemd
    # reads the uaccess tag. Upgrades from those versions leave the old file
    # behind only if it was edited; removing it here costs nothing and avoids
    # two rules disagreeing about the same device.
    rm -f /etc/udev/rules.d/99-vasak-press-and-hold.rules

    # The rules grant the session access to the input devices; without a reload
    # they only take effect after the next boot.
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=input 2>/dev/null || true
    udevadm trigger --name-match=uinput 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true

    echo ":: El selector de acentos arranca con la próxima sesión gráfica."
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -f /etc/systemd/user/graphical-session.target.wants/vasak-press-and-hold.service
    systemctl daemon-reload 2>/dev/null || true
}
